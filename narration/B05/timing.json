  "audioSha256": "a25334e655c0d71ebe4c51c714828655097a2d62da8dc5de373e679882effbbd",
  "captionsSha256": "7a00f7abeaa9b41d774b1132a66ad10900578a84ed68f27d9b8df3e4c1e07610",
  "scenes": [
    {
      "id": "compare",
      "scriptSha256": "516e9a67cdc5c0a8f88d71bac5f3afeb8edc2c3b4179a15a6729477a44c57f06",
      "durationFrames": 590,
      "cues": [
        {
          "start": 0.27,
          "end": 4.501,
          "text": "Take one request about the order\nvalidator. If you supply the function,"
        },
        {
          "start": 4.743,
          "end": 7.221,
          "text": "Copilot can explain its comparison."
        },
        {
          "start": 7.567,
          "end": 12.078,
          "text": "In an agent session, it may also choose\nan available tool to find the file,"
        },
        {
          "start": 12.459,
          "end": 15.078,
          "text": "read it, or validate a proposed change."
        },
        {
          "start": 15.586,
          "end": 18.704,
          "text": "Open the training workspace and look at\nthe session."
        },
        {
          "start": 19.131,
          "end": 23.41,
          "text": "Can you point to an actual tool event\nand the information it returned?"
        }
      ]
    },
    {
      "id": "loop",
      "scriptSha256": "9ec17be83f4ddd1354d278f358f025dd85020b25dada2e0f6e91db39b1991607",
      "durationFrames": 522,
      "cues": [
        {
          "start": 0.293,
          "end": 4.893,
          "text": "Watch the order of events. The agent\nreads that zero should be rejected,"
        },
        {
          "start": 5.228,
          "end": 9.459,
          "text": "then opens the validator and sees\ngreater than or equal to zero."
        },
        {
          "start": 9.908,
          "end": 14.131,
          "text": "That result gives it a reason to inspect\nthe tests for a zero case."
        },
        {
          "start": 14.743,
          "end": 17.29,
          "text": "Each next step depends on what the tool\nreturns."
        },
        {
          "start": 17.729,
          "end": 20.566,
          "text": "Check the event that led the agent to\nits conclusion."
        }
      ]
    },
    {
      "id": "scope",
      "scriptSha256": "f35fa88ae4c821e32e3afcf1bdeeb334dc87c4a8dd40c053aa697a91cffb57e1",
      "durationFrames": 544,
      "cues": [
        {
          "start": 0.293,
          "end": 5.241,
          "text": "Give Plan a task with a clear stopping\npoint. “Find why zero passes and"
        },
        {
          "start": 5.241,
          "end": 7.285,
          "text": "describe one regression test."
        },
        {
          "start": 7.873,
          "end": 11.347,
          "text": "Preserve the function signature and stop\nafter the plan.”"
        },
        {
          "start": 11.785,
          "end": 14.552,
          "text": "Review the named files and the reason\nfor the test."
        },
        {
          "start": 14.992,
          "end": 18.325,
          "text": "If the plan adds a dependency or changes\nother behavior,"
        },
        {
          "start": 18.684,
          "end": 21.163,
          "text": "narrow it before moving on to\nimplementation."
        }
      ]
    },
    {
      "id": "permissions",
      "scriptSha256": "ce12ae0ad4eaaf995589ae6ba783ce7d64ba724dc55dfb9470e4e1baa4a46a0b",
      "durationFrames": 579,
      "cues": [
        {
          "start": 0.316,
          "end": 4.969,
          "text": "If the session asks to run tests, read\nthe command and the working directory."
        },
        {
          "start": 5.314,
          "end": 9.222,
          "text": "Our example uses Python’s unittest\ndiscovery in the training checkout."
        },
        {
          "start": 9.567,
          "end": 14.515,
          "text": "That matches the agreed check. Verify\nwhere the process will actually run and"
        },
        {
          "start": 14.573,
          "end": 16.499,
          "text": "use the approved runner for this lab."
        },
        {
          "start": 16.891,
          "end": 20.53,
          "text": "If a command targets a different project\nor publishes changes,"
        },
        {
          "start": 20.866,
          "end": 22.767,
          "text": "stop and inspect what prompted it."
        }
      ]
    },
    {
      "id": "result",
      "scriptSha256": "af05c82642ca3f54a8f814cff568565a38c317a07a76707eece4805bdf4a8aed",
      "durationFrames": 538,
      "cues": [
        {
          "start": 0.339,
          "end": 4.802,
          "text": "Our run reports that the zero test\nfailed because true was returned where"
        },
        {
          "start": 4.802,
          "end": 6.101,
          "text": "false was expected."
        },
        {
          "start": 6.666,
          "end": 11.691,
          "text": "Find that line in the output. A chat\nmessage that says “tested” does not tell"
        },
        {
          "start": 11.691,
          "end": 12.7,
          "text": "you which case ran."
        },
        {
          "start": 13.219,
          "end": 16.258,
          "text": "The assertion helps you check the\nproposed diagnosis."
        },
        {
          "start": 16.698,
          "end": 20.92,
          "text": "Keep the output with the revision so a\nteammate can replay the result."
        }
      ]
    },
    {
      "id": "contexts",
      "scriptSha256": "95d32667c9ee5799732244a7f80a72cd7bdd36c47e301efd5b69b6142afba000",
      "durationFrames": 603,
      "cues": [
        {
          "start": 0.293,
          "end": 4.471,
          "text": "In this workplace, Copilot in VS Code is\nthe local entry point."
        },
        {
          "start": 4.863,
          "end": 8.886,
          "text": "Claude Code and OpenCode run in the\nmanaged G C P workspace."
        },
        {
          "start": 9.37,
          "end": 13.718,
          "text": "Open the approved environment for the\ntool you are using and confirm the"
        },
        {
          "start": 13.718,
          "end": 14.601,
          "text": "working folder."
        },
        {
          "start": 15.143,
          "end": 18.865,
          "text": "A tool call uses the permissions and\nruntime of its session."
        },
        {
          "start": 19.212,
          "end": 24.001,
          "text": "Check those before assuming a local file\nor command is available remotely."
        }
      ]
    },
    {
      "id": "stop",
      "scriptSha256": "166977cab9b8d5695105fb1ac9fedf94147cd78b34eddf2cc49c8d81fbf89d5e",
      "durationFrames": 538,
      "cues": [
        {
          "start": 0.293,
          "end": 2.359,
          "text": "Try a small read-and-report task."
        },
        {
          "start": 2.968,
          "end": 5.908,
          "text": "Ask the agent to inspect the validator\nand tests,"
        },
        {
          "start": 6.335,
          "end": 11.195,
          "text": "identify the line causing the behavior,\nand stop with the file path and relevant"
        },
        {
          "start": 11.195,
          "end": 11.845,
          "text": "evidence.",
          "speechEnd": 11.696
        },
        {
          "start": 12.353,
          "end": 17.319,
          "text": "Review the actual steps it took. If it\nstarts editing or proposes an unrelated"
        },
        {
          "start": 17.319,
          "end": 21.016,
          "text": "command, pause and bring the request\nback to the stated goal."
        }
      ]
    }
  ]
}
