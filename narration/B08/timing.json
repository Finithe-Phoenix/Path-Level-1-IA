  "delivery": {
    "targetWordsPerMinute": 149,
    "inputWordsPerMinute": 171.78,
    "tempo": 0.89166013,
    "outputWordsPerMinute": 149.02
  },
  "audioSha256": "4bb5a665d792550fbf9262cda61a321c4f066063fe1e9186f9082d1da07dd237",
  "captionsSha256": "4682cdf11484f32a719ab59e5f38f087a440ff6493e38c80de8550e68621c1c8",
  "scenes": [
    {
      "id": "start",
      "scriptSha256": "85fd8dd3f32f49ad38d6055f34a9fffa394c9404a9618ea655e6c3c03f196323",
      "durationFrames": 526,
      "cues": [
        {
          "start": 0.264,
          "end": 4.122,
          "text": "Before asking Copilot to edit, open\nSource Control in the training"
        },
        {
          "start": 4.122,
          "end": 4.772,
          "text": "workspace.",
          "speechEnd": 4.768
        },
        {
          "start": 5.352,
          "end": 9.68,
          "text": "The demonstration starts on a disposable\nbranch with a clean working tree."
        },
        {
          "start": 10.04,
          "end": 13.399,
          "text": "If you already have edits, note their\nfiles and contents."
        },
        {
          "start": 13.802,
          "end": 18.438,
          "text": "That baseline matters later. You want to\nrecognize your own work before using a"
        },
        {
          "start": 18.438,
          "end": 20.465,
          "text": "control that can discard a change."
        }
      ]
    },
    {
      "id": "proposal",
      "scriptSha256": "8ee599ddf60e0be8561647f43d4074e549e39d0591ea22fdfed7f030079ff460",
      "durationFrames": 546,
      "cues": [
        {
          "start": 0.286,
          "end": 5.123,
          "text": "Look at the proposed patch. One change\nreplaces greater than or equal to zero"
        },
        {
          "start": 5.123,
          "end": 6.49,
          "text": "with greater than zero."
        },
        {
          "start": 7.019,
          "end": 9.721,
          "text": "The new assertion checks the missing\nboundary case."
        },
        {
          "start": 10.194,
          "end": 14.706,
          "text": "A third change touches a notes file.\nRead that diff and ask which requirement"
        },
        {
          "start": 14.706,
          "end": 15.703,
          "text": "it satisfies."
        },
        {
          "start": 16.04,
          "end": 20.457,
          "text": "In this exercise it is unrelated, so we\ncan remove it while keeping the two"
        },
        {
          "start": 20.513,
          "end": 21.267,
          "text": "useful edits."
        }
      ]
    },
    {
      "id": "prove",
      "scriptSha256": "d0c9174af6e49c28a3a594195192ef8f9c9652fe639445a34c643547ffaffbd7",
      "durationFrames": 539,
      "cues": [
        {
          "start": 0.287,
          "end": 2.763,
          "text": "Review the runner output linked to the\nexercise."
        },
        {
          "start": 3.17,
          "end": 7.344,
          "text": "Before the source edit, the zero\nassertion failed for the expected"
        },
        {
          "start": 7.344,
          "end": 7.994,
          "text": "reason.",
          "speechEnd": 7.709
        },
        {
          "start": 8.372,
          "end": 11.245,
          "text": "After the edit, it passes with three\nearlier cases."
        },
        {
          "start": 11.751,
          "end": 14.913,
          "text": "Keep both outputs visible while\nevaluating the patch."
        },
        {
          "start": 15.463,
          "end": 19.646,
          "text": "They help explain why the validator and\ntest edits belong together and the"
        },
        {
          "start": 19.646,
          "end": 21.021,
          "text": "unrelated note does not."
        }
      ]
    },
    {
      "id": "undo",
      "scriptSha256": "b31be3b0faf236b7c8f675cc5328d9c8e59e6fea860d194a7ffb6a088cd00f29",
      "durationFrames": 531,
      "cues": [
        {
          "start": 0.308,
          "end": 4.923,
          "text": "Open the notes diff in Source Control.\nIf the file contains only the unwanted"
        },
        {
          "start": 4.935,
          "end": 7.393,
          "text": "agent edit, discard that file's change."
        },
        {
          "start": 7.966,
          "end": 12.591,
          "text": "If it also contains work you need, use a\nnarrower edit or revert the confirmed"
        },
        {
          "start": 12.591,
          "end": 13.241,
          "text": "hunk.",
          "speechEnd": 12.901
        },
        {
          "start": 13.418,
          "end": 18.541,
          "text": "Read the diff again after the action.\nThe validator and the added test should"
        },
        {
          "start": 18.541,
          "end": 20.582,
          "text": "still be in the changed-file list."
        }
      ]
    },
    {
      "id": "recheck",
      "scriptSha256": "f4e218589b711343b3b52d55c7c34ed4b6e65f7a73e38e73b3538cfe80e20c98",
      "durationFrames": 579,
      "cues": [
        {
          "start": 0.264,
          "end": 1.809,
          "text": "Check Source Control again."
        },
        {
          "start": 2.225,
          "end": 7.36,
          "text": "Confirm the validator and test are the\nonly changes expected for this exercise,"
        },
        {
          "start": 7.754,
          "end": 10.665,
          "text": "then rerun the suite in the approved\nenvironment."
        },
        {
          "start": 11.26,
          "end": 15.344,
          "text": "All four tests should pass. If the\nregression disappears from the run,"
        },
        {
          "start": 15.762,
          "end": 17.371,
          "text": "inspect the test diff again."
        },
        {
          "start": 17.73,
          "end": 22.033,
          "text": "Verifying the result after undo is what\ntells you that the useful changes"
        },
        {
          "start": 22.033,
          "end": 22.691,
          "text": "survived."
        }
      ]
    },
    {
      "id": "checkpoint",
      "scriptSha256": "12d75ff214406704f4e9b71043367aae155bed9864402ddd162dddc76983e12d",
      "durationFrames": 494,
      "cues": [
        {
          "start": 0.264,
          "end": 5.111,
          "text": "When one hunk is wrong, reverse that\nhunk. If a whole file contains just the"
        },
        {
          "start": 5.144,
          "end": 8.305,
          "text": "unwanted edit, a file-level discard may\nbe enough."
        },
        {
          "start": 8.692,
          "end": 13.018,
          "text": "For a broader session checkpoint, read\nwhich changes it will affect before"
        },
        {
          "start": 13.03,
          "end": 13.535,
          "text": "using it."
        },
        {
          "start": 13.851,
          "end": 17.954,
          "text": "The choice depends on the diff you\ninspected and any unrelated work that"
        },
        {
          "start": 17.954,
          "end": 19.062,
          "text": "must stay in place."
        }
      ]
    },
    {
      "id": "practice",
      "scriptSha256": "4c8735394927931b617af033b89b349b33091305f52cd860c96035d0fd0494a7",
      "durationFrames": 544,
      "cues": [
        {
          "start": 0.286,
          "end": 4.095,
          "text": "Finish by explaining the final patch.\nZero is now rejected."
        },
        {
          "start": 4.482,
          "end": 8.383,
          "text": "The signature stays the same. The new\ntest proves the boundary,"
        },
        {
          "start": 8.687,
          "end": 10.86,
          "text": "and the original cases still pass."
        },
        {
          "start": 11.333,
          "end": 14.834,
          "text": "Name the unrelated edit you removed and\nshow the remaining diff."
        },
        {
          "start": 15.239,
          "end": 19.964,
          "text": "That gives your teammate both the change\nthey need to review and the evidence you"
        },
        {
          "start": 19.964,
          "end": 21.286,
          "text": "checked after recovery."
        }
      ]
    }
  ]
}
