  "paceBuild": "7a0b9dc6b272af6c23c55267f90843c6fdbab3453f7942970e3a58684b324e5c",
  "delivery": {
    "targetWordsPerMinute": 149,
    "inputWordsPerMinute": 172.18,
    "tempo": 0.88222762,
    "outputWordsPerMinute": 149.02
  },
  "audioSha256": "aa7efe2c0cd51d7d96fba73cce914db58b7658b9468acc4731b512d02e3cf41c",
  "captionsSha256": "0655acdaf13806165e03983ba30e3d4857bf04eb7a9b6d2f0e9a2ee8b31ba984",
  "scenes": [
    {
      "id": "map",
      "scriptSha256": "53b2e3ace5895459f831e4eb0eb6c09220b411b8cc32cbaf380f3fa626e09ff4",
      "durationFrames": 548,
      "cues": [
        {
          "start": 0.289,
          "end": 3.321,
          "text": "An order issue arrives and the team\nneeds three things."
        },
        {
          "start": 3.753,
          "end": 7.354,
          "text": "Someone must explain the validator, find\nthe rule in our notes,"
        },
        {
          "start": 7.775,
          "end": 8.876,
          "text": "and label the issue."
        },
        {
          "start": 9.286,
          "end": 13.015,
          "text": "Those tasks can share the same text, yet\nthe outputs are different."
        },
        {
          "start": 13.492,
          "end": 18.052,
          "text": "Start by naming the deliverable. Once\nyou know what must come back,"
        },
        {
          "start": 18.428,
          "end": 21.624,
          "text": "you can pick a capability and a way to\ncheck the result."
        }
      ]
    },
    {
      "id": "language",
      "scriptSha256": "766d436ef0058d1ebcc07c57fe0dd72a184030447cf058094d9e3463afbb2607",
      "durationFrames": 573,
      "cues": [
        {
          "start": 0.266,
          "end": 5.376,
          "text": "Give Copilot the return line and ask it\nto explain the result for zero and one."
        },
        {
          "start": 5.865,
          "end": 9.6,
          "text": "A language model can produce an\nexplanation in ordinary words."
        },
        {
          "start": 10.054,
          "end": 14.486,
          "text": "Check those words against the\nexpression. Both numbers satisfy this"
        },
        {
          "start": 14.486,
          "end": 15.136,
          "text": "condition.",
          "speechEnd": 15.117
        },
        {
          "start": 15.674,
          "end": 17.846,
          "text": "If the answer says zero is rejected,"
        },
        {
          "start": 18.04,
          "end": 22.161,
          "text": "you've found a specific sentence to\nquestion and a one-line source to point"
        },
        {
          "start": 22.161,
          "end": 22.811,
          "text": "to.",
          "speechEnd": 22.485
        }
      ]
    },
    {
      "id": "embeddings",
      "scriptSha256": "c93bc6aa416e6680d3bbe09271ca8db471b09fae0b6eaf3fe0653bd98a124313",
      "durationFrames": 595,
      "cues": [
        {
          "start": 0.289,
          "end": 3.484,
          "text": "Now imagine the rule lives in one of\nthree training notes."
        },
        {
          "start": 3.962,
          "end": 7.81,
          "text": "An embedding model turns the query and\nthe stored notes into vectors."
        },
        {
          "start": 8.219,
          "end": 11.888,
          "text": "The system compares those\nrepresentations and ranks possible"
        },
        {
          "start": 11.888,
          "end": 12.538,
          "text": "matches.",
          "speechEnd": 12.439
        },
        {
          "start": 12.803,
          "end": 15.903,
          "text": "A useful first result is the order\nacceptance note."
        },
        {
          "start": 16.527,
          "end": 20.542,
          "text": "Open it and read the rule. Similarity\nhelps you find a source."
        },
        {
          "start": 21.099,
          "end": 23.587,
          "text": "The source itself tells you what the\nrule says."
        }
      ]
    },
    {
      "id": "classification",
      "scriptSha256": "069154d52218707d6807d4ce0f1b1abd9210168ed5b001eb7fdc3d1e7971f831",
      "durationFrames": 602,
      "cues": [
        {
          "start": 0.266,
          "end": 4.329,
          "text": "For the issue label, our outputs are\ndefect, feature, or question."
        },
        {
          "start": 4.646,
          "end": 8.926,
          "text": "The ticket reports behavior that already\ncontradicts a documented rule."
        },
        {
          "start": 9.244,
          "end": 11.667,
          "text": "That gives us a reason to choose defect."
        },
        {
          "start": 12.123,
          "end": 14.864,
          "text": "A classifier can propose the label\ndirectly,"
        },
        {
          "start": 15.126,
          "end": 18.937,
          "text": "and a language model can also choose\nfrom a short allowed list."
        },
        {
          "start": 19.346,
          "end": 23.515,
          "text": "Check which wording in the issue\nsupports the decision before applying"
        },
        {
          "start": 23.515,
          "end": 24.165,
          "text": "it.",
          "speechEnd": 23.704
        }
      ]
    },
    {
      "id": "media",
      "scriptSha256": "bc53098bc153b010b494c1699f6fcedee7efd914c89ff4cc7b48ad26d272471b",
      "durationFrames": 587,
      "cues": [
        {
          "start": 0.266,
          "end": 5.019,
          "text": "Think of the materials for a training\nlesson. A screenshot can go into a"
        },
        {
          "start": 5.019,
          "end": 7.431,
          "text": "vision-capable model for a description."
        },
        {
          "start": 7.772,
          "end": 11.293,
          "text": "A written brief can go into an image\nmodel for an illustration."
        },
        {
          "start": 11.794,
          "end": 14.784,
          "text": "Audio can go into a transcription system\nfor text."
        },
        {
          "start": 15.193,
          "end": 18.76,
          "text": "Check a screenshot description against\nthe visible controls."
        },
        {
          "start": 19.294,
          "end": 23.256,
          "text": "Check a transcript against an important\nsentence in the recording."
        }
      ]
    },
    {
      "id": "tool",
      "scriptSha256": "bd734e553b2bf04fd1c29949684538507a5140978518f1c03623edbe144e2b23",
      "durationFrames": 544,
      "cues": [
        {
          "start": 0.334,
          "end": 4.798,
          "text": "Some tools combine these steps. A\nquestion about zero quantities might"
        },
        {
          "start": 4.798,
          "end": 7.078,
          "text": "first retrieve the most relevant note."
        },
        {
          "start": 7.423,
          "end": 10.473,
          "text": "The language model then uses that note\nto draft an answer."
        },
        {
          "start": 10.814,
          "end": 14.557,
          "text": "When you see the final paragraph, trace\nit back through the citation."
        },
        {
          "start": 14.989,
          "end": 20.13,
          "text": "If retrieval found an outdated rule, the\nanswer can sound convincing and still"
        },
        {
          "start": 20.188,
          "end": 21.379,
          "text": "use the wrong evidence."
        }
      ]
    },
    {
      "id": "route",
      "scriptSha256": "daef05e9845ff40fc48cab97d17263d99633b8259d308b53d74b0894a4d584dd",
      "durationFrames": 542,
      "cues": [
        {
          "start": 0.266,
          "end": 4.269,
          "text": "Choose a task from the training\nrepository and finish this sentence."
        },
        {
          "start": 4.916,
          "end": 7.608,
          "text": "“I need this input turned into this\noutput,"
        },
        {
          "start": 7.893,
          "end": 9.835,
          "text": "and I will check it by doing this.”"
        },
        {
          "start": 10.29,
          "end": 15.218,
          "text": "For example, use a language model to\nexplain the validator and verify the"
        },
        {
          "start": 15.218,
          "end": 17.577,
          "text": "explanation against the code and a test."
        },
        {
          "start": 18.077,
          "end": 21.117,
          "text": "Once that check is clear, you're ready\nto compare options."
        }
      ]
    }
  ]
}
